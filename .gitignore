# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP screenshots
.playwright-mcp/
.tmp-fixtures/

# Review screenshots taken at the repo root during UI work
/*.png

# Ralph loop session state
.claude/ralph-loop.local.md

# Agent skills installed by `npx skills add` — local tooling, not app code
.agents/
.junie/
skills-lock.json
.claude/skills/

# Rendered email previews from `npm run preview:email` — regenerate, do not commit
.email-previews/
