# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP screenshots
.playwright-mcp/
.tmp-fixtures/

# Review screenshots taken at the repo root during UI work
/*.png

# Ralph loop session state
.claude/ralph-loop.local.md

# Agent skills installed by `npx skills add` — local tooling, not app code
.agents/
.junie/
skills-lock.json
.claude/skills/

# Rendered email previews from `npm run preview:email` — regenerate, do not commit
.email-previews/

# Git worktrees Claude Code checks out inside the repo. Never committable,
# and each holds a copy of biome.json — which Biome reads as a second root
# configuration and refuses to run at all until it is out of the way.
.claude/worktrees/

# Caption snapshots, which `npm run recaption -- --apply` writes before it
# edits anything. Live database text, kept so a run can be put back — not
# documentation, and not something to carry into a commit by accident. The
# two already tracked here stay tracked; git ignores this only for new files.
docs/snapshots/

# JetBrains project files. Editor state, not project configuration —
# `copilotDiffState.xml` was tracking a pending diff for a route deleted
# months ago.
.idea/
