    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2
    },
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/api/**",
        "src/lib/database.ts",
        "src/lib/auth/**",
        "src/lib/photos/**",
        "src/lib/ai/offer.ts",
        "src/lib/maptiler.ts",
        "src/lib/members/offer.ts",
        "src/lib/site-url.ts",
        "src/lib/stripe.ts",
        "src/components/ui/EnvironmentBanner.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "vitest.config.mts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.test.ts", "src/lib/source-text.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
